{
  "expo": {
    "name": "OS Técnicos",
    "slug": "os-tecnicos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.conexaoweb.ostecnicos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F9EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.conexaoweb.ostecnicos"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O aplicativo usa a sua localização para registrar o local onde o serviço foi feito."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O aplicativo usa a câmera para ler o QR code dos lotes e para fotografar o serviço.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo acessa as suas fotos para você escolher as imagens do serviço.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "ostecnicos"
  }
}
