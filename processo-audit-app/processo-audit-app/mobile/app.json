{
  "expo": {
    "name": "CW Campo",
    "slug": "cw-campo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.net.cwtelecom.campo",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#274518",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.net.cwtelecom.campo",
      "versionCode": 1,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#274518",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O aplicativo usa a sua localização para registrar o local onde o serviço foi feito."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O aplicativo usa a câmera para ler o QR code dos lotes e para fotografar o serviço.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo acessa as suas fotos para você escolher as imagens do serviço.",
          "cameraPermission": "O aplicativo usa a câmera para ler o QR code dos lotes e para fotografar o serviço.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "cwcampo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "558f378f-03f1-4075-bbe7-64493cbe25e3"
      }
    },
    "owner": "conexao-web",
    "updates": {
      "url": "https://u.expo.dev/558f378f-03f1-4075-bbe7-64493cbe25e3"
    }
  }
}
