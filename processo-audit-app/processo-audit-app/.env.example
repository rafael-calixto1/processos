# ========================================
# Exemplo de Variáveis de Ambiente
# Copie para .env e preencha com seus dados
# ========================================

# ========== DATABASE ==========
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=processo_audit

# ========== SERVER ==========
PORT=5000
NODE_ENV=development

# ========== AUTHENTICATION ==========
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_2024

# ========== CORS ==========
CORS_ORIGIN=http://localhost:3000

# ========================================
# Notas:
# - JWT_SECRET: Use uma string aleatória longa para produção
# - DB_PASSWORD: Use uma senha forte em produção
# - CORS_ORIGIN: Para produção, use https://seu-dominio.com
# - NODE_ENV: Use 'production' em produção
# ========================================
